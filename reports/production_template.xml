<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_sale_order_production">
            <t t-call="web.report_layout">
                <t t-as="doc" t-foreach="docs">
                    <t t-set="style" t-value="doc.style or res_company.df_style"></t>
                    <t t-if="doc and 'company_id' in doc">
                        <t t-set="company" t-value="doc.company_id"></t>
                    </t>
                    <t t-if="not doc or not 'company_id' in doc">
                        <t t-set="company" t-value="res_company"></t>
                    </t>
                    <div class="header">
                        <div class="">
                            <div class="row align-items-center">
                                <div class="col-6">
                                    <div>
                                        <span t-if="style.logo">
                                            <img alt="Logo" t-att-src="image_data_uri(style.logo)" t-if="style.logo"></img>
                                        </span>
                                        <span t-if="not style.logo">
                                            <img alt="Logo" t-att-src="image_data_uri(company.logo)" t-if="company.logo"></img>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="d-inline-block" t-attf-style="                                 background-color: {{style.theme_color}};                                 border-radius: 20px 0px 0px 20px;                                 padding: 5px 10px;                                 height: 40px;">
                                        <span style="                                     font-size:1rem;                                     font-weight: 700;">
                                            <t t-if="doc.production_state not in ['witout']">ORDEN DE TRABAJO</t>
                                            <t t-else="">ORDEN DE VENTA</t>
                                        </span>
                                    </div>
                                    <p class="" style="                                     font-size:1rem;                                     font-weight: 700;">No. <t t-out="doc.name"></t></p>
                                    <p t-attf-style="                                 color:{{style.text_color}}">
                                        <t t-out="doc.date_order.strftime('%d / %m / %Y')"></t>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="article page" t-attf-data-oe-id="{{doc.id}}" t-attf-data-oe-model="sale.order" t-attf-style="color:{{style.text_color}} !important;font-size:{{int(style.body_font)}}px !important;font-family:{{style.font_family}} !important;">
                        <div class="col-12" t-attf-style="white-space:pre-line;color:#{style.wm_color};left:#{style.leftpadding}mm; top:#{style.toppadding}mm;font-size:#{style.fontsize}px; opacity:#{style.opacity};z-index:-99; -webkit-transform:rotate(-#{style.rotate}deg);position:fixed;">
                            <t t-esc="style.wm_eval(doc, time, user, res_company)"></t>
                        </div>
                        <div class="row row-cols-2 mb-4" t-attf-style="                     background-color: #e9eaec;                     padding: 10px 15px;                     border-radius: 15px;">
                            <div class="col-8">
                                <div>
                                    <t t-if="doc.partner_id.parent_id">
                                        <div style="margin-bottom:0px;text-transform: uppercase;font-size: 1rem;font-weight: 700;" t-field="doc.partner_id.parent_id"></div>
                                        <div style="margin-bottom:0px;font-size: 0.8rem;">Contacto: <span t-field="doc.partner_id.name"></span></div>
                                    </t>
                                    <t t-else="">
                                        <div style="margin-bottom:0px;text-transform: uppercase;font-size: 1rem;font-weight: 700;" t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;:[&quot;name&quot;],&quot;no_marker&quot;: false}"></div>
                                        <div style="margin-bottom:0px; font-size:0.8rem;">Contacto: <span t-field="doc.partner_id.custom_contact"></span></div>
                                    </t>
                                    <div t-attf-style="margin-bottom:0px;color:{{style.text_color}};" t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;:[&quot;phone&quot;,&quot;mobile&quot;],&quot;no_marker&quot;: false}"></div>
                                    <div t-attf-style="margin-bottom:0px;color:{{style.text_color}};" t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;:[&quot;email&quot;],&quot;no_marker&quot;: false}"></div>
                                    <br></br>
                                    <t t-if="doc.production_note">
                                        <div style="margin-bottom:0px;text-transform: uppercase;font-size: 1rem;font-weight: 700;">OBSERVACIONES:</div>
                                        <div style="margin-bottom:0px;text-transform: uppercase;font-size: 1rem;">
                                            <span t-field="doc.production_note"></span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="col-4 d-flex justify-content-end">
                                <table class="table table-sm table-borderless" style="font-size:0.8rem">
                                    <tbody>
                                        <tr>
                                            <td class="text-center" t-attf-style="color:{{style.text_color}};font-weight: 700;">FECHA DE ENTREGA:</td>
                                        </tr>
                                        <tr>
                                            <td class="text-center" t-attf-style="color:{{style.text_color}};">
                                                <span t-field="doc.commitment_date"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center" t-attf-style="color:{{style.text_color}};font-weight: 700;">Referencia del Cliente:</td>
                                        </tr>
                                        <tr>
                                            <td class="text-center" t-attf-style="color:{{style.text_color}};">
                                                <span t-field="doc.client_order_ref"></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!--Data-->
                        <t t-call="shokale_templates.shokale_order_lines"></t>
                        <!--/Data-->
                    </div>
                    <!--End of PAGE-->
                    <div class="footer">
                        <div class="container-fluid py-2">
                            <div class="row align-items-center">
                                <div class="col text-end">
                                    <div t-if="doc.user_id">
                                        <strong>Elaborada por:</strong>
                                        <strong t-field="doc.user_id"></strong>
                                        <br></br>
                                    </div>
                                </div>
                            </div>
                            <div class="row align-items-center bg-dark text-white py-2 ">
                                <div class="col-4 text-center">
                                    <i class="fa fa-phone"></i>
                                    <span><t t-out="doc.company_id.partner_id.phone"></t> / <t t-out="doc.company_id.partner_id.mobile"></t></span>
                                </div>
                                <div class="col-4 text-center justify-content-center">
                                    <i class="fa fa-envelope"></i>
                                    <span>
                                        <t t-out="doc.company_id.partner_id.email"></t>
                                    </span>
                                </div>
                                <div class="col-4 text-center justify-content-end">
                                    <i class="fa fa-globe me-2"></i>
                                    <span>
                                        <t t-out="doc.company_id.partner_id.website"></t>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!-- <t t-call="shokale_templates.shokale_company_footer"/> -->
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
