<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="paperformat_print_oficio_sv" model="report.paperformat">
    <field name="name">Reporte Oficio SV</field>
    <field name="default" eval="True" />
    <field name="format">custom</field>
    <field name="page_height">216</field>
    <field name="page_width">140</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">30</field>
    <field name="header_spacing">25</field>
    <field name="margin_bottom">20</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="False" />
    <field name="dpi">110</field>
  </record>

  <record id="sale_order_production" model="ir.actions.report">
    <field name="name">Orden de Trabajo</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">tgr_sale_shokale.report_sale_order_production</field>
    <field name="report_file">tgr_sale_shokale.report_sale_order_production</field>
    <field name="binding_model_id" ref="model_sale_order" />
    <field name="binding_type">report</field>
    <field name="print_report_name">(object._get_report_base_filename())</field>
    <field name="attachment"
      >(object.name+'.pdf')</field
    >

    <field
      name="paperformat_id"
      ref="tgr_sale_shokale.paperformat_print_oficio_sv"
    />
  </record>
</odoo>

