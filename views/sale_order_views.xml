<odoo>
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.production</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"></field>
        <field name="arch" type="xml">
            <!-- Botón para pasar a producción -->
            <xpath expr="//header" position="inside">
                <field invisible="1" name="production_state"></field>
                <button class="btn btn-primary" invisible="state != 'sale' or invoice_status == 'invoiced' or production_state!='without'" name="action_production" string="Pasar a Producción" type="object"></button>
                <button class="btn btn-success" invisible="production_state  != 'production'" name="action_production_done" string="Producción Terminada" type="object"></button>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or production_state == 'production'</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget invisible="production_state!='production'" name="web_ribbon" title="En Producción"></widget>
                <widget bg_color="bg-info" invisible="production_state!='production_done'" name="web_ribbon" title="Producción Terminada"></widget>
            </xpath>
            <!-- Add referencia del cliente -->
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="client_order_ref"></field>
            </xpath>
            <field name="date_order" position="after">
                <field name="commitment_date"></field>
            </field>
            <xpath expr="//group[@name='note_group']" position="inside">
                <group colspan="4">
                    <field colspan="2" name="production_note"></field>
                </group>
            </xpath>
        </field>
    </record>
    <record id="sale_order_view_tree_inherit_production" model="ir.ui.view">
        <field name="name">sale.order.view.tree.inherit.production</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"></field>
        <field name="arch" type="xml">
            <!-- Agregar el campo production_state a la vista de análisis de ventas -->
            <xpath expr="//tree" position="inside">
                <field decoration-info="production_state=='without'" decoration-primary="production_state=='production'" decoration-success="production_state=='production_done'" name="production_state" optional="hide" widget="badge"></field>
            </xpath>
        </field>
    </record>
</odoo>
